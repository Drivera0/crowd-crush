# Copy to .env (git-ignored). Everything is optional: with nothing set, Pulse
# still detects, records to recordings/auto/, uses template briefings and the
# browser's own voice.

# Tiger Data (TimescaleDB) connection string
TIGER_DATABASE_URL=

# Gemini briefings
GEMINI_API_KEY=
# Fast enough for the 5 s briefing limit (~1.5 s); gemini-flash-latest can take 6 s+ or be overloaded.
# GEMINI_MODEL=gemini-3.5-flash-lite

# ElevenLabs voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Boards. Plugged into this laptop by USB (table demo; scripts/boards.sh env --write fills it in):
#   SIGN_URL=serial:auto,A=serial:auto,B=serial:auto
# Over Wi-Fi: http://<uno ip>,A=http://<esp32 ip>,B=http://<esp32 ip>
SIGN_URL=

# URL phones should open, for the dashboard QR code. A link pasted in the dashboard's QR window wins
# over it; without either, a running Cloudflare quick tunnel is found by itself, else the dashboard's own host.
# CLOUDFLARED_METRICS=localhost:20241   (where to look for the quick tunnel; "off" = don't look)
# PUBLIC_URL=https://pulse.example.tech

# Phone-to-phone mesh (WebRTC): STUN servers, comma-separated. Default stun:stun.l.google.com:19302;
# set it empty for host candidates only (phones on one Wi-Fi, no internet needed).
# PULSE_STUN=
